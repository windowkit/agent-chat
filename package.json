{
  "name": "@windowkit/agent-chat",
  "version": "0.0.0",
  "description": "An embeddable chat UI for local AI agent harnesses, for react-x11: the Claude Agent SDK first, your own tools as functions, your own renderers, and every action interceptable.",
  "keywords": [
    "react-x11",
    "agent",
    "claude",
    "chat",
    "ai",
    "desktop"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./drivers/claude": {
      "types": "./dist/drivers/claude/index.d.ts",
      "default": "./dist/drivers/claude/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "tsx scripts/check-package.ts",
    "examples:demo": "tsx examples/demo.tsx",
    "examples:claude": "tsx examples/claude.tsx",
    "examples:tools": "tsx examples/tools.tsx",
    "examples:intercept": "tsx examples/intercept.tsx",
    "examples:peers": "tsx examples/peers.tsx",
    "screenshots": "tsx scripts/screenshot.tsx"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.300 <0.4.0",
    "@react-x11/components": ">=0.38.0 <0.44.0",
    "react": "^19.0.0",
    "react-x11": "^2.56.3"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@react-x11/components": "^0.43.0",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.0",
    "react": "^19.2.8",
    "react-x11": "^2.58.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.1.0"
  }
}
